# Copy this file to .env.multitenant-services. Do not commit the copied file.
# Use URL-safe random values (for example, hexadecimal) for all database secrets.

COMPOSE_PROJECT_NAME=lightrag-multitenant-services
LIGHTRAG_ENV_FILE=.env.multitenant-services
LIGHTRAG_IMAGE=lightrag-multitenant:services
LIGHTRAG_BIND_HOST=127.0.0.1
LIGHTRAG_PORT=9621

LIGHTRAG_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
TOKEN_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_ASYNC=4

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_MAX_ASYNC=8

LIGHTRAG_MAX_LOADED_KNOWLEDGE_BASES=32
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
RERANK_BINDING=null

POSTGRES_USER=lightrag
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_URL_SAFE_RANDOM_VALUE
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_VECTOR_INDEX_TYPE=HNSW

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_GENERATE_A_URL_SAFE_RANDOM_VALUE
NEO4J_DATABASE=neo4j

REDIS_PASSWORD=CHANGE_ME_GENERATE_A_URL_SAFE_RANDOM_VALUE

# Do not define POSTGRES_WORKSPACE, NEO4J_WORKSPACE, or REDIS_WORKSPACE here.
