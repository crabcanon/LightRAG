# Copy this file to .env.multitenant-standalone. Do not commit the copied file.
# The default bind address is loopback. Set LIGHTRAG_BIND_HOST=0.0.0.0 only
# behind a trusted reverse proxy with TLS and authentication.

COMPOSE_PROJECT_NAME=lightrag-multitenant-standalone
LIGHTRAG_ENV_FILE=.env.multitenant-standalone
LIGHTRAG_IMAGE=lightrag-multitenant:standalone
LIGHTRAG_BIND_HOST=127.0.0.1
LIGHTRAG_PORT=9621

# Generate unique production values. They protect the LightRAG API, not tenant ACLs.
LIGHTRAG_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
TOKEN_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# OpenAI-compatible chat completion endpoint.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_ASYNC=4

# OpenAI-compatible embedding endpoint. EMBEDDING_DIM must match the model output
# and must not change after a knowledge base has been populated.
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_MAX_ASYNC=8

# Keep the process single-replica for the file-backed deployment.
LIGHTRAG_MAX_LOADED_KNOWLEDGE_BASES=16
LIGHTRAG_MULTI_WORKSPACE_MODE=multi
LIGHTRAG_KNOWLEDGE_BASE_CATALOG_PROVIDER=local
LIGHTRAG_WORKSPACE_COORDINATOR_PROVIDER=local
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
RERANK_BINDING=null
