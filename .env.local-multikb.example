# Copy to .env.local-multikb and replace every CHANGE_ME value.
# Never commit the copied file.

LIGHTRAG_ENV_FILE=.env.local-multikb
LIGHTRAG_LOCAL_PORT=9621
LIGHTRAG_API_KEY=CHANGE_ME_LOCAL_API_KEY
TOKEN_SECRET=CHANGE_ME_RANDOM_TOKEN_SECRET

LIGHTRAG_MULTI_WORKSPACE_MODE=multi
LIGHTRAG_KNOWLEDGE_BASE_CATALOG_PROVIDER=local
LIGHTRAG_WORKSPACE_COORDINATOR_PROVIDER=local

LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
LLM_MODEL=gpt-4o-mini

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=CHANGE_ME_OPENAI_COMPATIBLE_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Optional strict physical-isolation profiles mounted by the app profile.
# LIGHTRAG_STORAGE_PROFILES_FILE=/app/config/storage-profiles.json

LIGHTRAG_KV_STORAGE=RedisKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-password
POSTGRES_DATABASE=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_VECTOR_INDEX_TYPE=HNSW

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lightrag-local-password
NEO4J_DATABASE=neo4j
NEO4J_URI=neo4j://127.0.0.1:7687

REDIS_URI=redis://127.0.0.1:6379/0

# Do not set POSTGRES_WORKSPACE, NEO4J_WORKSPACE, or REDIS_WORKSPACE.
# Those process-wide overrides are incompatible with dynamic knowledge bases.

ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
RERANK_BINDING=null
